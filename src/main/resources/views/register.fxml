<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="moonbean.controller.RegisterController"
            prefWidth="600" prefHeight="400">

    <center>
        <VBox spacing="15" alignment="CENTER">
            <Label text="Register Account" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="firstNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="lastNameField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>

                <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250"/>
            </GridPane>

            <Label fx:id="errorLabel" textFill="red" style="-fx-font-size: 12px;" />

            <HBox spacing="10" alignment="CENTER">
                <Button text="Register" onAction="#onRegister" />
                <Button text="Back to Login" onAction="#onBackToLogin" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
