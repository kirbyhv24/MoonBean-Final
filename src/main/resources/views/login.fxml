<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="moonbean.controller.LoginController">
    <center>
        <VBox spacing="12" alignment="CENTER">
            <Label text="MoonBean Café" style="-fx-font-size:26; -fx-font-weight:bold;"/>
            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <HBox spacing="10" alignment="CENTER">
                <Button text="Login" onAction="#onLogin"/>
                <Button text="Register" onAction="#onRegister"/>
                <Button text="Continue as Guest" onAction="#onGuest"/>
            </HBox>
            <Label fx:id="errorLabel" textFill="red"/>
        </VBox>
    </center>
</BorderPane>
